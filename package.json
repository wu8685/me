{
  "name": "me",
  "version": "1.7.0",
  "description": "A Claude Code / Codex plugin for knowledge management and evidence-backed decision briefs",
  "scripts": {
    "test": "bash test/vault-test.sh",
    "test:ingest": "bun test test/ingest-*.test.ts",
    "test:doctor": "bun test test/doctor.test.ts",
    "test:recall": "bun test test/recall.test.ts",
    "test:distill": "bun test test/distill.test.ts",
    "test:update": "bun test test/update-*.test.ts",
    "test:release-guard": "bun test test/release-guard.test.ts",
    "release:guard": "bun run bin/release-guard.ts check",
    "release:record": "bun run bin/release-guard.ts record"
  },
  "files": [
    ".agents/plugins/marketplace.json",
    ".claude-plugin/",
    ".codex-plugin/",
    ".release-digests.json",
    "AGENTS.md",
    "CLAUDE.md",
    "DEVELOPMENT.md",
    "LEGAL.md",
    "bin/",
    "docs/development.md",
    "docs/features.md",
    "docs/philosophy.md",
    "docs/user-guide.md",
    "references/",
    "skills/",
    "templates/"
  ],
  "bin": {
    "checklinks": "bun run bin/checklinks.ts",
    "autolinks": "bun run bin/autolinks.ts",
    "backlinks": "bun run bin/backlinks.ts",
    "move": "bun run bin/move.ts",
    "ingest": "bun run bin/ingest.ts",
    "me-runtime": "bin/runtime.ts",
    "doctor": "bin/doctor.ts",
    "recall": "bin/recall.ts",
    "distill": "bin/distill.ts",
    "me-setup": "bin/setup.ts",
    "me-update": "bin/update.ts",
    "vault-write": "bin/vault-write.ts"
  },
  "keywords": [
    "knowledge-management",
    "obsidian",
    "vault",
    "wikilinks"
  ],
  "author": "wuke <optimuswu8685@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "yaml": "^2.9.0"
  }
}
